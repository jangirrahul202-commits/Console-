{
  "manifest_version": 3,
  "name": "Console+ for Salesforce",
  "version": "1.3.0",
  "description": "Advanced Apex developer console with code coverage, SOQL builder, diff checker, debug logs, and AI-powered insights. Opens as a standalone window like Lightning Studio.",
  "author": "Salesforce Developer Tools",
  "homepage_url": "https://github.com/salesforce-apex-console",
  "permissions": [
    "cookies",
    "storage",
    "activeTab",
    "tabs",
    "system.display",
    "notifications"
  ],
  "host_permissions": [
    "*://*.salesforce.com/*",
    "*://*.salesforce-setup.com/*",
    "*://*.force.com/*",
    "*://*.cloudforce.com/*",
    "*://*.my.site.com/*"
  ],
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Apex Console"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
